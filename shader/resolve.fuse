--[[
IgelkottFisheye @VERSION@ for DaVinci Resolve (Fusion page) and Fusion Studio - Igelkott Film AB, https://igelkottplates.com

Walls straight from the square fisheye clip (PYXIS 12K, Sony Venice 2 or Z-Cam E2 S6), the way IgelkottStage plays them:
one resampling, through the lens model, on the GPU. The clip is read at its own size (MediaIn in the clip's own Fusion
composition), and the output is Wall Width x Wall Height: set it to the timeline's resolution, the wall (Eric 2026-11-25:
a clip's composition has the clip's size, not the timeline's, and a Fusion Clip shrinks the plate to the timeline
before the effect). Tested in Resolve Studio 21.1 on a Mac: a 1920 x 1080 output on a 1920 x 1080 timeline lands
pixel for pixel.

Camera and Pointing on Auto (tag) read the camera and the lens direction from the plate's pixel tag. A plate without the
tag is not an Igelkott clip and is not played: black, NOT AN IGELKOTT CLIP / IGELKOTTPLATES.COM and a warning sign.

Install: copy this file to
  macOS:   ~/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Fuses/
  Windows: C:\ProgramData\Blackmagic Design\DaVinci Resolve\Fusion\Fuses\
and restart Resolve. Select the plate in the timeline, open the Fusion page, put IgelkottFisheye between MediaIn1 and
MediaOut1 (Add Tool > Fuses > Igelkott) and set Wall Width and Wall Height to the timeline's resolution.

GENERATED by tools/build_shaders.py from shader/resolve.fuse and shader/core.dctl: edit those, then run
python tools/build_shaders.py. The camera numbers come from _shared/IgelkottFisheyeLens.
--]]

FuRegisterClass("IgelkottFisheye", CT_Tool, {
	REGS_Name = "IgelkottFisheye",
	REGS_Category = "Fuses\\Igelkott",
	REGS_OpIconString = "IgF",
	REGS_OpDescription = "IgelkottFisheye by Igelkott Film AB, igelkottplates.com",
	REGS_HelpTopic = "https://igelkottplates.com",
	REGS_URL = "https://igelkottplates.com",
	REGS_Company = "Igelkott Film AB",
	REG_NoMotionBlurCtrls = true,
	REG_NoBlendCtrls = true,
	REG_NoObjMatCtrls = true,
	REG_OpNoMask = true,
	REG_Fuse_NoEdit = false,
	REG_Fuse_NoReload = false,
})

IgkParams = [[
	int camera;
	int pointing;
	int mode;
	int split;
	float offset[4];
	float view[4];
	float viewR[4];
	float splitPos;
	int dstsize[2];
]]

IgkSource = [==[
@KERNEL@
]==]

local function slider(name, id, default, lo, hi, softLo, softHi, tip)
	return self:AddInput(name, id, {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = default,
		INP_MinAllowed = lo, INP_MaxAllowed = hi,
		INP_MinScale = softLo, INP_MaxScale = softHi,
		INPS_StatusText = tip,
	})
end

function Create()
	-- The brand on two lines: one line is cut off in Resolve's Inspector (seen 2026-11-25)
	self:AddInput("IgelkottFisheye by Igelkott Film AB", "Brand", {
		LINKID_DataType = "Text", INPID_InputControl = "LabelControl", INP_External = false, INP_Passive = true,
	})
	self:AddInput("igelkottplates.com", "BrandURL", {
		LINKID_DataType = "Text", INPID_InputControl = "LabelControl", INP_External = false, INP_Passive = true,
	})
	InCamera = self:AddInput("Camera", "Camera", {
		LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0, INP_Integer = true,
		CC_LabelPosition = "Horizontal",
		INPS_StatusText = "Auto (tag): the camera from the plate's pixel tag (a plate without the tag is not played)",
		{ CCS_AddString = "Auto (tag)" }, { CCS_AddString = "PYXIS 12K" }, { CCS_AddString = "Sony Venice 2" },
		{ CCS_AddString = "Z-Cam E2 S6" },
	})
	InPointing = self:AddInput("Pointing", "Pointing", {
		LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0, INP_Integer = true,
		CC_LabelPosition = "Horizontal",
		INPS_StatusText = "Auto (tag): from the pixel tag. Zenith = lens up (car plates), Nadir = lens down (flying plates)",
		{ CCS_AddString = "Auto (tag)" }, { CCS_AddString = "Zenith" }, { CCS_AddString = "Nadir" },
	})
	InMode = self:AddInput("Mode", "Mode", {
		LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0, INP_Integer = true,
		CC_LabelPosition = "Horizontal",
		INPS_StatusText = "Wall: a flat view. Equirect: 360 degrees over the whole width, aimed with Yaw, Pitch and Roll",
		{ CCS_AddString = "Wall" }, { CCS_AddString = "Equirect" },
	})
	InYaw = slider("Yaw", "Yaw", 0, -360, 360, -180, 180, "Turns right (yaw 0 looks at the middle of FisheyetoEqui's equirect)")
	InPitch = slider("Pitch", "Pitch", 0, -90, 90, -90, 90, "Looks up")
	InRoll = slider("Roll", "Roll", 0, -180, 180, -180, 180, "Rotates the wall around its view direction")
	InFov = slider("FOV", "FOV", 90, 1, 179, 1, 179, "Horizontal angle, from the left edge of the wall to the right edge")
	InOffsetX = slider("Offset X", "OffsetX", 0, -8000, 8000, -500, 500, "Moves the finished picture right: output pixels")
	InOffsetY = slider("Offset Y", "OffsetY", 0, -8000, 8000, -500, 500, "Moves the finished picture up: output pixels")
	InSplit = self:AddInput("Split", "Split", {
		LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 0, INP_Integer = true,
		INPS_StatusText = "Two walls side by side from the same plate, with a sharp edge at Split Position",
	})
	InSplitPos = slider("Split Position", "SplitPosition", 50, 0, 100, 0, 100, "The edge between the walls, % of the width")
	InYawR = slider("Right Yaw", "RightYaw", 0, -360, 360, -180, 180, "Split: the right wall's Yaw")
	InPitchR = slider("Right Pitch", "RightPitch", 0, -90, 90, -90, 90, "Split: the right wall's Pitch")
	InRollR = slider("Right Roll", "RightRoll", 0, -180, 180, -180, 180, "Split: the right wall's Roll")
	InFovR = slider("Right FOV", "RightFOV", 90, 1, 179, 1, 179, "Split: the right wall's horizontal angle")
	InOffsetXR = slider("Right Offset X", "RightOffsetX", 0, -8000, 8000, -500, 500, "Split: moves the right wall's picture right")
	InOffsetYR = slider("Right Offset Y", "RightOffsetY", 0, -8000, 8000, -500, 500, "Split: moves the right wall's picture up")

	InWallW = self:AddInput("Wall Width", "WallWidth", {
		LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 3840, INP_Integer = true,
		INP_MinAllowed = 16, INP_MaxAllowed = 32768, INP_MinScale = 16, INP_MaxScale = 16384,
		INPS_StatusText = "The wall's width in pixels: the timeline's resolution",
	})
	InWallH = self:AddInput("Wall Height", "WallHeight", {
		LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 2160, INP_Integer = true,
		INP_MinAllowed = 16, INP_MaxAllowed = 32768, INP_MinScale = 16, INP_MaxScale = 8640,
		INPS_StatusText = "The wall's height in pixels: the timeline's resolution",
	})

	InImage = self:AddInput("Input", "Input", { LINKID_DataType = "Image", LINK_Main = 1 })
	OutImage = self:AddOutput("Output", "Output", { LINKID_DataType = "Image", LINK_Main = 1 })
end

function Process(req)
	local img = InImage:GetValue(req)
	-- The wall: Wall Width x Wall Height (the clip's composition has the clip's size, not the timeline's)
	local w = math.floor(InWallW:GetValue(req).Value)
	local h = math.floor(InWallH:GetValue(req).Value)
	local out = Image({
		IMG_Document = self.Comp, IMG_Width = w, IMG_Height = h, IMG_Depth = 8,
		IMG_XScale = 1, IMG_YScale = 1, IMG_Quality = not req:IsQuick(), IMG_ProxyScale = 1,
	})
	local node = DVIPComputeNode(req, "IgkKernel", IgkSource, "IgkParams", IgkParams)
	if node then
		local p = node:GetParamBlock(IgkParams)
		p.camera = InCamera:GetValue(req).Value
		p.pointing = InPointing:GetValue(req).Value
		p.mode = InMode:GetValue(req).Value
		p.split = InSplit:GetValue(req).Value
		p.offset[0] = InOffsetX:GetValue(req).Value
		p.offset[1] = InOffsetY:GetValue(req).Value
		p.offset[2] = InOffsetXR:GetValue(req).Value
		p.offset[3] = InOffsetYR:GetValue(req).Value
		p.view[0] = InYaw:GetValue(req).Value
		p.view[1] = InPitch:GetValue(req).Value
		p.view[2] = InRoll:GetValue(req).Value
		p.view[3] = InFov:GetValue(req).Value
		p.viewR[0] = InYawR:GetValue(req).Value
		p.viewR[1] = InPitchR:GetValue(req).Value
		p.viewR[2] = InRollR:GetValue(req).Value
		p.viewR[3] = InFovR:GetValue(req).Value
		p.splitPos = InSplitPos:GetValue(req).Value
		p.dstsize[0] = w
		p.dstsize[1] = h
		node:SetParamBlock(p)
		node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR, TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_TRUE)
		node:AddInput("src", img)
		node:AddOutput("dst", out)
		if not node:RunSession(req) then
			out = nil
		end
	else
		out = nil
	end
	OutImage:Set(req, out)
end
