#version 120

// IgelkottFisheye2D for Assimilate Live FX - Igelkott Film AB
// GENERATED by tools/build_shaders.py from shader/ (version 0.21): edit shader/core.glsl and the wrapper, then run
// python tools/build_shaders.py. The camera numbers come from _shared/IgelkottFisheyeLens.

uniform sampler2D front;

// PYXIS 12K (FisheyeLens.pyxis12K): reference width, lens centre, r(theta) in source pixels
const float IGK_PYXIS_REF = 8040.0;
const vec2 IGK_PYXIS_CENTER = vec2(4019.9389914282037, 4019.9389463189077);
const vec4 IGK_PYXIS_K = vec4(2068.8673345215607, -31.032060077989637, 0.1394366394877631, -0.00029359255648059773);
// Sony Venice 2 (FisheyeLens.sonyVenice2): reference width, lens centre, r(theta) in source pixels
const float IGK_VENICE_REF = 5760.0;
const vec2 IGK_VENICE_CENTER = vec2(2848.031459694644, 2854.3896750742356);
const vec4 IGK_VENICE_K = vec4(1440.3464186123263, -21.606695057429874, 0.09789618777410111, -0.0002943394610105899);
// Z-Cam E2 S6 (FisheyeLens.zcamE2S6): reference width, lens centre, r(theta) in source pixels
const float IGK_ZCAM_REF = 3872.0;
const vec2 IGK_ZCAM_CENTER = vec2(1936.0, 1936.0);
const vec4 IGK_ZCAM_K = vec4(965.3796533166083, -9.478101051830038, 0.2498244786039206, -0.5051113655662752);
// Colours from IgelkottDesign's tokens (color.warning #FACC15, color.text #FFFFFF, color.accent #00BCDB)
const vec3 IGK_WARNING_YELLOW = vec3(0.980392, 0.800000, 0.082353);
const vec3 IGK_BRAND_TEXT = vec3(1.000000, 1.000000, 1.000000);
const vec3 IGK_BRAND_ACCENT = vec3(0.000000, 0.737255, 0.858824);

// IgelkottFisheye core: the lens, the nadir turn, the pixel tag, the warning sign and the refusal message. One source
// for Live FX (Matchbox, GLSL 1.20) and PIXERA (GLSL 4.50): tools/build_shaders.py puts the camera numbers in front of this text and one of the
// wrappers (matchbox.glsl, pixera.glsl) after it. Keep to what both read: no integer bit operations, no arrays, no
// `texture2D`. In shader/core.glsl the source is read with a placeholder the script swaps for each host (uv in fractions
// of the picture, top row first); functions that read it take the sampler as a first parameter in PIXERA only.
//
// Directions: y up, z straight ahead (yaw 0 = the middle of the equirect FisheyetoEqui makes), x right.
// The lens points straight up: theta from the zenith, r(theta) = k1*t + k2*t^3 + k3*t^5 + k4*t^7,
// point = centre + (d.x, d.z) * r(theta) / sin(theta) (FisheyeLens.point in _shared/IgelkottFisheyeLens).
// Nadir (lens pointing down, flying plate): the direction is read as (x, -y, -z), 180 degrees about X, as Stage 1 and Motion.

const float IGK_PI = 3.14159265358979;
// Degrees to radians without the built-in radians(): PIXERA's own effects define a radians() of their own
// (Ref-Eric/Equirectangular.glsl.txt), which would clash in a stricter compiler.
const float IGK_DEG = 0.017453292519943295;

// Cameras: the pixel tag's codes. 1 PYXIS 12K, 2 Sony Venice 2, 3 Z-Cam E2 S6 (FisheyeLens.zcamE2S6, 2026-11-20),
// 0 and 4-7 none.
bool igkHasModel(int cam) {
    return cam >= 1 && cam <= 3;
}

vec2 igkLensCenter(int cam) {
    if (cam == 3) return IGK_ZCAM_CENTER / IGK_ZCAM_REF;
    return cam == 2 ? IGK_VENICE_CENTER / IGK_VENICE_REF : IGK_PYXIS_CENTER / IGK_PYXIS_REF;
}

vec4 igkLensK(int cam) {
    if (cam == 3) return IGK_ZCAM_K / IGK_ZCAM_REF;
    return cam == 2 ? IGK_VENICE_K / IGK_VENICE_REF : IGK_PYXIS_K / IGK_PYXIS_REF;
}

// The direction's point in the source, fractions of the picture, top row first
vec2 igkLensPoint(vec3 d, int cam, bool nadir) {
    if (nadir) d = vec3(d.x, -d.y, -d.z);
    vec4 k = igkLensK(cam);
    float rho = length(d.xz);
    float th = atan(rho, d.y);
    float t2 = th * th;
    float poly = k.x + t2 * (k.y + t2 * (k.z + t2 * k.w));
    float f = rho > 1e-9 ? poly * th / rho : poly;
    return igkLensCenter(cam) + d.xz * f;
}

bool igkInside(vec2 p) {
    return p.x >= 0.0 && p.x <= 1.0 && p.y >= 0.0 && p.y <= 1.0;
}

// R = Ry(yaw) * Rx(-pitch) * Rz(roll), as IgelkottStage (CameraCost.rotation) and Eq->2D
mat3 igkRotation(float y, float p, float r) {
    y *= IGK_DEG; p *= -IGK_DEG; r *= IGK_DEG;
    mat3 ry = mat3(cos(y), 0.0, -sin(y),   0.0, 1.0, 0.0,   sin(y), 0.0, cos(y));
    mat3 rx = mat3(1.0, 0.0, 0.0,   0.0, cos(p), sin(p),   0.0, -sin(p), cos(p));
    mat3 rz = mat3(cos(r), sin(r), 0.0,   -sin(r), cos(r), 0.0,   0.0, 0.0, 1.0);
    return ry * rx * rz;
}

// A flat wall: c = the point relative to the wall's middle (y up), ww = the wall's width in the same units, fov = the
// horizontal angle from the wall's left edge to its right edge (Eric 2026-11-20: 90 degrees means 90 degrees along the
// horizon; until 0.17 it was the vertical angle, as Eq->2D), r = the wall's igkRotation (built once per pixel)
vec3 igkWallDirection(vec2 c, float ww, mat3 r, float fov) {
    float f = 0.5 * max(ww, 1e-4) / tan(clamp(fov, 1.0, 179.0) * IGK_DEG * 0.5);
    return r * normalize(vec3(c.x / f, c.y / f, 1.0));
}

// Mode Equirect (Eric 2026-11-20): 360 degrees over the whole canvas width w, the same degrees per pixel up and down
// ("crop to 360 wide"). c = the point relative to the middle of its wall (y up): one wall without Split, each Split wall
// a window centred on its own Yaw/Pitch/Roll (r = its igkRotation) at the same scale ("same scale, own aim"); FOV is
// not used. A 2:1 canvas
// without Split, Yaw 0, is the whole sphere as FisheyetoEqui's equirect (lon 0 in the middle); wider canvases are cropped
// top and bottom (32:9: 101 degrees); past a pole is black (w = 0 in the result).
vec4 igkEquirectDirection(vec2 c, float w, mat3 r) {
    float k = 2.0 * IGK_PI / w;
    float lat = c.y * k;
    if (abs(lat) > 0.5 * IGK_PI) return vec4(0.0);
    float lon = c.x * k;
    return vec4(r * vec3(cos(lat) * sin(lon), sin(lat), cos(lat) * cos(lon)), 1.0);
}

// MARK: The pixel tag (PixelTag in _shared/IgelkottFisheyeLens, IgelkottLensMark; the rules live there)
// Two rows of ten cells, 0.011 of the side, along the top edge next to the QR code: x 0.116-0.226, y 0.010-0.032, in all
// four corners mirrored as the QR codes. Cell 0 white, cell 1 black (a cell is 1 above the middle between them), then
// version (2 bits, 1), camera (3), nadir, adjusted, horizon burnt in, 4 free, CRC-6 (0x27, start 0x3F, top bit first).
// The fisheye is square, so fractions of the side are fractions of the picture.

const float IGK_TAG_CELL = 0.011;
const float IGK_TAG_X = 0.116;
const float IGK_TAG_Y = 0.010;
const float IGK_TAG_MIN_CONTRAST = 0.1;

// The middle of cell i in corner k (0 top left, 1 top right, 2 bottom left, 3 bottom right), top row first
vec2 igkTagCell(int k, int i) {
    float fi = float(i);
    float row = floor(fi / 10.0);
    vec2 p = vec2(IGK_TAG_X + (fi - 10.0 * row + 0.5) * IGK_TAG_CELL, IGK_TAG_Y + (row + 0.5) * IGK_TAG_CELL);
    if (k == 1 || k == 3) p.x = 1.0 - p.x;
    if (k >= 2) p.y = 1.0 - p.y;
    return p;
}

float igkLuma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// c XOR 39 (binary 100111) for c in 0..63, without integer bit operations: each set bit of 39 flips that bit of c.
float igkXor39(float c) {
    float r = c;
    r += mod(c, 2.0) > 0.5 ? -1.0 : 1.0;
    r += mod(floor(c / 2.0), 2.0) > 0.5 ? -2.0 : 2.0;
    r += mod(floor(c / 4.0), 2.0) > 0.5 ? -4.0 : 4.0;
    r += c >= 32.0 ? -32.0 : 32.0;
    return r;
}

// One bit into the CRC-6 (polynomial 0x27 = 39)
float igkCrcStep(float crc, float bit) {
    float top = crc >= 32.0 ? 1.0 : 0.0;
    crc = mod(crc * 2.0, 64.0);
    return top != bit ? igkXor39(crc) : crc;
}

// The tag in corner k: camera * 2 + nadir, or -1 (no contrast, wrong version or wrong CRC). Its 20 texture reads are what
// the tag costs (measured 2026-11-21 on a Radeon RX 9070 XT: the CRC maths is not the cost).
float igkTagCorner(int k) {
    float white = igkLuma(texture2D(front, igkTagCell(k, 0)).rgb);
    float black = igkLuma(texture2D(front, igkTagCell(k, 1)).rgb);
    if (white - black < IGK_TAG_MIN_CONTRAST) return -1.0;
    float mid = 0.5 * (white + black);
    float data = 0.0;
    float crc = 63.0;
    float check = 0.0;
    for (int i = 2; i < 20; i++) {
        float bit = igkLuma(texture2D(front, igkTagCell(k, i)).rgb) > mid ? 1.0 : 0.0;
        if (i < 14) {
            data = data * 2.0 + bit;
            crc = igkCrcStep(crc, bit);
        } else {
            check = check * 2.0 + bit;
        }
    }
    if (check != crc || floor(data / 1024.0) != 1.0) return -1.0;
    return mod(floor(data / 128.0), 8.0) * 2.0 + mod(floor(data / 64.0), 2.0);
}

float igkVotes(float t, float a, float b, float c, float d) {
    return t < 0.0 ? 0.0 : (a == t ? 1.0 : 0.0) + (b == t ? 1.0 : 0.0) + (c == t ? 1.0 : 0.0) + (d == t ? 1.0 : 0.0);
}

// The tag most corners agree on (camera * 2 + nadir), or -1 when no corner reads
float igkTag(float unused) {
    float a = igkTagCorner(0);
    float b = igkTagCorner(1);
    // Two agreeing corners decide it: no other value can get more than two votes, and a tie goes to corner 0. Saves half
    // the reads for an ordinary tagged plate (2026-11-21: the tag was ~84 % of the shader's time at 15360 x 2160).
    if (a >= 0.0 && a == b) return a;
    float c = igkTagCorner(2);
    float d = igkTagCorner(3);
    float best = a;
    float n = igkVotes(a, a, b, c, d);
    float m = igkVotes(b, a, b, c, d);
    if (m > n) { best = b; n = m; }
    m = igkVotes(c, a, b, c, d);
    if (m > n) { best = c; n = m; }
    m = igkVotes(d, a, b, c, d);
    if (m > n) { best = d; n = m; }
    return best;
}

// The plate: vec3(camera, nadir 0/1, state). Eric 2026-11-20: Auto is a choice in each list, no Plate control.
// Camera: 0 Auto (the tag's camera), 1 PYXIS 12K, 2 Sony Venice 2, 3 Z-Cam E2 S6. Pointing: 0 Auto, 1 Zenith, 2 Nadir.
// State 0: play. State 1: a camera without a lens model (a tag code 4-7, none today): black and the warning, never
// another camera's model. State 2: no valid tag, whatever the lists say (Eric 2026-11-23: the shader refuses a plate
// without the code, with a message that it is not an Igelkott clip): black, the message and the warning.
vec3 igkPlate(float tag, int camera, int pointing) {
    if (tag < 0.0) return vec3(0.0, 0.0, 2.0);
    int cam = camera == 0 ? int(floor(tag / 2.0 + 0.25)) : camera;
    float nadir = pointing == 0 ? mod(tag, 2.0) : (pointing == 2 ? 1.0 : 0.0);
    return vec3(float(cam), nadir, igkHasModel(cam) ? 0.0 : 1.0);
}

// The warning sign: a small yellow triangle with a black "!" in the top left corner of the output, no text.
// q = the point in the output from its top left corner, size = the triangle's side, in the same units.
// 0 = not on the sign, 1 = yellow, 2 = black.
float igkWarning(vec2 q, float size) {
    vec2 p = (q - vec2(0.5 * size)) / size;          // 0..1 over the sign's box, y down
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 0.9) return 0.0;
    if (abs(p.x - 0.5) > 0.5 * p.y / 0.9) return 0.0;
    if (abs(p.x - 0.5) < 0.06 && ((p.y > 0.3 && p.y < 0.62) || (p.y > 0.7 && p.y < 0.8))) return 2.0;
    return 1.0;
}

// IGK_WARNING_YELLOW (warning), IGK_BRAND_TEXT (text) and IGK_BRAND_ACCENT (accent) come from IgelkottDesign's tokens, written in by
// tools/build_shaders.py (atlas rule 17: no colour typed by hand).

// MARK: The refusal message (state 2), in the warning's yellow across the middle of the output: NOT AN IGELKOTT CLIP and
// under it IGELKOTTPLATES.COM, where Igelkott plates come from (Eric 2026-11-23: "branding is important"). Letters of 5 x 7
// dots, 6 dots apart: the first line 20 letters (119 dots wide), the second 18 letters one letter in, 4 dots below. Each
// letter is two whole numbers: rows 0-3 and rows 4-6, 5 bits per row, the left dot highest. Letters 0-19 are the first
// line, 20-37 the second. Read with floor and mod only (no integer bit operations, no arrays); dividing by a power of
// two is exact in float, and the largest number (2^20) is well inside float's 24 bits.

vec2 igkMessageGlyph(int i) {
    if (i == 0 || i == 5) return vec2(583347.0, 17969.0);                                   // N
    if (i == 1 || i == 12 || i == 25 || i == 36) return vec2(476721.0, 17966.0);            // O
    if (i == 2 || i == 13 || i == 14 || i == 26 || i == 27 || i == 31) return vec2(1020036.0, 4228.0);   // T
    if (i == 4 || i == 30) return vec2(476735.0, 17969.0);                                  // A
    if (i == 7 || i == 18 || i == 20) return vec2(462980.0, 4238.0);                        // I
    if (i == 8 || i == 21) return vec2(476695.0, 17967.0);                                  // G
    if (i == 9 || i == 22 || i == 32) return vec2(1032734.0, 16927.0);                      // E
    if (i == 10 || i == 17 || i == 23 || i == 29) return vec2(541200.0, 16927.0);           // L
    if (i == 11 || i == 24) return vec2(576152.0, 21073.0);                                 // K
    if (i == 16 || i == 35) return vec2(476688.0, 16942.0);                                 // C
    if (i == 19 || i == 28) return vec2(1001022.0, 16912.0);                                // P
    if (i == 33) return vec2(508430.0, 1086.0);                                             // S
    if (i == 34) return vec2(0.0, 396.0);                                                   // .
    if (i == 37) return vec2(585397.0, 17969.0);                                            // M
    return vec2(0.0);                                                                       // the spaces (3, 6, 15)
}

// 32^n and 2^n for n = 0..3 and 0..4, written out so no GPU's pow() can land a hair under a power of two
float igkPow32(float n) {
    return n < 0.5 ? 1.0 : (n < 1.5 ? 32.0 : (n < 2.5 ? 1024.0 : 32768.0));
}

float igkPow2(float n) {
    return n < 0.5 ? 1.0 : (n < 1.5 ? 2.0 : (n < 2.5 ? 4.0 : (n < 3.5 ? 8.0 : 16.0)));
}

// q = the point in the output from its top left corner (y down), size = the output's width and height, same units.
// 1 on a dot of the first line, 2 on IGELKOTTPLATES (the brand's text colour), 3 on .COM (the brand's cyan, Eric
// 2026-11-23: ".com in our cyan"), else 0. The first line is 70 % of the width or 15 % of the height, whichever is smaller; the
// two lines (18 dots high) sit centred.
float igkMessage(vec2 q, vec2 size) {
    float unit = min(0.7 * size.x / 119.0, 0.15 * size.y / 7.0);
    vec2 p = (q - 0.5 * size) / unit + vec2(59.5, 9.0);                  // dots from the text's top left
    if (p.x < 0.0 || p.x >= 119.0 || p.y < 0.0 || p.y >= 18.0) return 0.0;
    float letter = floor(p.x / 6.0);
    float col = floor(p.x - 6.0 * letter);
    if (col > 4.5) return 0.0;
    float row = floor(p.y);
    float line = 1.0;
    if (row > 6.5) {                                                    // the second line, rows 11-17, letters 1-18
        if (row < 10.5 || letter < 0.5 || letter > 18.5) return 0.0;
        row -= 11.0;
        letter += 19.0;
        line = letter > 33.5 ? 3.0 : 2.0;                               // .COM is letters 34-37
    }
    vec2 g = igkMessageGlyph(int(letter));
    float bits = row < 3.5 ? mod(floor(g.x / igkPow32(3.0 - row)), 32.0) : mod(floor(g.y / igkPow32(6.0 - row)), 32.0);
    return line * mod(floor(bits / igkPow2(4.0 - col)), 2.0);
}

// Live FX (Matchbox). For movie files Live FX lays the source and the output out top row first (seen on Mac 2026-10-05
// and on Windows 2026-10-28): texture row 0 is the top of the picture and gl_FragCoord.y counts from the top. PNG clips
// are laid out bottom row first (Windows 2026-11-19): there the wall comes out turned 180 degrees.

uniform float adsk_result_w, adsk_result_h;

uniform int camera;
uniform int pointing;
uniform float offset_x;
uniform float offset_y;
uniform float offset_xr;
uniform float offset_yr;
uniform int mode;
uniform float yaw;
uniform float pitch;
uniform float roll;
uniform float fov;
uniform bool split;
uniform float split_pos;
uniform float yaw_r;
uniform float pitch_r;
uniform float roll_r;
uniform float fov_r;

void main() {
    float tag = igkTag(0.0);                    // always: a plate without the tag is refused (Eric 2026-11-23)
    vec3 pl = igkPlate(tag, camera, pointing);
    int cam = int(pl.x + 0.5);
    bool nadir = pl.y > 0.5;
    // Offset X/Y move the finished picture, after the projection (Eric 2026-11-20): output pixels, +X right, +Y up; the
    // left wall's with Split on, and Right Offset X/Y the right wall's. The Split edge stays where Split Position puts it.
    float w = adsk_result_w;
    float h = adsk_result_h;
    float splitX = split ? clamp(split_pos, 0.0, 100.0) * 0.01 * w : w;
    mat3 rLeft = igkRotation(yaw, pitch, roll);
    mat3 rRight = igkRotation(yaw_r, pitch_r, roll_r);
    vec3 sum = vec3(0.0);
    if (pl.z < 0.5) {
        // 2 x 2 samples over the pixel
        for (int j = 0; j < 2; j++) {
            for (int i = 0; i < 2; i++) {
                vec2 q = gl_FragCoord.xy + (vec2(float(i), float(j)) + 0.5) * 0.5 - 0.5;
                q.y = h - q.y;                                                  // y up from the bottom
                bool right = q.x >= splitX;                                     // Split on, the right wall
                vec2 s = q - (right ? vec2(offset_xr, offset_yr) : vec2(offset_x, offset_y));
                vec2 c = s - vec2(right ? 0.5 * (splitX + w) : 0.5 * splitX, 0.5 * h);   // from the wall's middle
                vec3 d;
                if (mode == 1) {
                    vec4 e = igkEquirectDirection(c, w, right ? rRight : rLeft);
                    if (e.w < 0.5) continue;                                    // past a pole: black
                    d = e.xyz;
                } else {
                    d = igkWallDirection(c, right ? w - splitX : splitX, right ? rRight : rLeft, right ? fov_r : fov);
                }
                vec2 p = igkLensPoint(d, cam, nadir);
                if (igkInside(p)) sum += texture2D(front, p).rgb;
            }
        }
    }
    vec3 color = sum * 0.25;
    if (pl.z > 1.5) {
        float m = igkMessage(gl_FragCoord.xy, vec2(w, h));
        if (m > 0.5) color = m > 2.5 ? IGK_BRAND_ACCENT : (m > 1.5 ? IGK_BRAND_TEXT : IGK_WARNING_YELLOW);
    }
    if (pl.z > 0.5) {
        float mark = igkWarning(gl_FragCoord.xy, max(16.0, 0.05 * h));
        if (mark > 1.5) color = vec3(0.0);
        else if (mark > 0.5) color = IGK_WARNING_YELLOW;
    }
    gl_FragColor = vec4(color, 1.0);
}
